# Copy this file to .env and fill in YOUR values. DO NOT commit .env.

# MT5 terminal path on your PC (Program Files location for Exness MT5)
MT5_PATH=C:\Program Files\Exness MetaTrader 5\terminal64.exe

# Leave empty ("") if you just open MT5 and log in yourself.
# Login + password only needed if MT5 is NOT already logged in.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional: override symbols from config.py
SYMBOLS=USDZAR